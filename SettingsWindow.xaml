<Window x:Class="StickyNotes.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bezel Sticky Notes Settings"
        Width="500"
        Height="570"
        MinWidth="500"
        MaxWidth="500"
        MinHeight="570"
        MaxHeight="570"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        FontFamily="Segoe UI"
        Foreground="#2F3237">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#34373C"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#E9EBEF"/>
            <Setter Property="Foreground" Value="#2F3237"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#2F3237"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Foreground" Value="#2F3237"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2F3237"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="BorderBrush" Value="#18000000"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Account &amp; Plan"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="PlanSummaryText"
                                       Text="7-day free trial"
                                       FontSize="14.5"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="EntitlementStatusText"
                                       Grid.Column="1"
                                       Text="Checking..."
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="AccountEmailText"
                                   Text="Checking account..."
                                   Margin="0,5,0,0"
                                   FontSize="13.5"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,9,0,0">
                            <Button x:Name="AccountActionButton"
                                    Content="Loading..."
                                    IsEnabled="False"
                                    Click="AccountButton_Click"/>

                            <Button x:Name="PremiumButton"
                                    Content="Go Premium"
                                    Margin="8,0,0,0"
                                    Background="#30343A"
                                    Foreground="White"
                                    Click="PremiumButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Notifications"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="NotificationStatusText"
                                   Text="Loading..."
                                   Margin="0,7,0,0"
                                   FontSize="13.5"
                                   Foreground="#646A73"/>

                        <StackPanel x:Name="BackendNotificationsPanel"
                                    Visibility="Collapsed"
                                    Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
<Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="General"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="Start StickyNotes with Windows"
                                  Margin="0,7,0,0"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Default note color"
                                           FontSize="14"/>

                                <TextBlock Text="Used for newly created notes"
                                           FontSize="13"
                                           Margin="0,1,0,0"
                                           Foreground="#646A73"/>
                            </StackPanel>

                            <ComboBox x:Name="DefaultColorComboBox"
                                      Grid.Column="1"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Yellow"/>
                                <ComboBoxItem Content="Mint"/>
                                <ComboBoxItem Content="Blue"/>
                                <ComboBoxItem Content="Orange"/>
                                <ComboBoxItem Content="Slate"/>
                                <ComboBoxItem Content="Forest"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Cloud"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Sync will use storage you own."
                                   Margin="0,6,0,0"
                                   FontSize="13.5"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,7,0,0">
                            <Button Content="Google Drive"
                                    IsEnabled="False"
                                    Margin="0,0,8,0"/>

                            <Button Content="OneDrive"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="About"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="VersionText"
                                       Margin="0,2,0,0"
                                       FontSize="13"
                                       Foreground="#646A73"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="View details"
                                VerticalAlignment="Center"
                                Click="AboutButton_Click"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1"
              Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Exit StickyNotes"
                    Foreground="#783D3D"
                    Click="ExitButton_Click"/>

            <TextBlock x:Name="SaveStatusText"
                       Grid.Column="1"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="#2E7D32"
                       FontSize="13.5"/>

            <Button Grid.Column="2"
                    Content="Close"
                    Margin="0,0,8,0"
                    Click="CloseButton_Click"/>

            <Button Grid.Column="3"
                    Content="Save"
                    Background="#30343A"
                    Foreground="White"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>