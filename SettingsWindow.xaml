<Window x:Class="StickyNotes.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="StickyNotes Settings" Width="560" Height="650" MinWidth="520" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F4F5F7" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#E9EBEF" />
      <Setter Property="Foreground" Value="#34383E" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="BorderBrush" Value="#18000000" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="2,0,2,16">
      <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Foreground="#30343A" />
      <TextBlock Text="StickyNotes preferences and account" Margin="0,4,0,0" FontSize="13.5" Foreground="#747980" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Text="Account &amp; Plan" FontSize="16" FontWeight="SemiBold" Foreground="#30343A" />
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="7-day free trial" FontSize="15" FontWeight="SemiBold" Foreground="#34383E" />
                <TextBlock Text="Trial starts when your account is activated." Margin="0,3,0,0" FontSize="13" Foreground="#757A82" />
              </StackPanel>
              <Border Grid.Column="1" Padding="10,5" Background="#FFF2D6" CornerRadius="10" VerticalAlignment="Center">
                <TextBlock Text="Not started" FontSize="12.5" Foreground="#7B5B17" />
              </Border>
            </Grid>
            <Button Content="Sign in / Create account" Margin="0,16,0,0" HorizontalAlignment="Left" IsEnabled="False" ToolTip="Firebase account connection is the next backend phase" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Foreground="#30343A" />
            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start StickyNotes with Windows" Margin="0,14,0,0" />
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Screen edge" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Where StickyNotes rests" FontSize="12.5" Foreground="#777C84" />
              </StackPanel>
              <ComboBox x:Name="EdgeComboBox" Grid.Column="1" SelectedIndex="1">
                <ComboBoxItem Content="Top" />
                <ComboBoxItem Content="Right" />
                <ComboBoxItem Content="Bottom" />
                <ComboBoxItem Content="Left" />
              </ComboBox>
            </Grid>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Default note color" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Used for newly created notes" FontSize="12.5" Foreground="#777C84" />
              </StackPanel>
              <ComboBox x:Name="DefaultColorComboBox" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="Yellow" />
                <ComboBoxItem Content="Mint" />
                <ComboBoxItem Content="Blue" />
                <ComboBoxItem Content="Orange" />
                <ComboBoxItem Content="Slate" />
                <ComboBoxItem Content="Forest" />
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Text="Cloud" FontSize="16" FontWeight="SemiBold" Foreground="#30343A" />
            <TextBlock Text="Your note content will sync only to storage you own." Margin="0,8,0,0" FontSize="13.5" Foreground="#666C74" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Content="Google Drive" IsEnabled="False" Margin="0,0,8,0" />
              <Button Content="OneDrive" IsEnabled="False" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Foreground="#30343A" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="StickyNotes" FontSize="14" VerticalAlignment="Center" />
              <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="13.5" Foreground="#747980" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Your notes remain local unless you explicitly enable your own cloud storage." Margin="0,10,0,0" FontSize="12.5" Foreground="#777C84" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="Exit StickyNotes" Foreground="#783D3D" Click="ExitButton_Click" />
      <TextBlock x:Name="SaveStatusText" Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="#34383E" HorizontalAlignment="Right" FontSize="13.5" FontWeight="SemiBold" />
      <Button Grid.Column="2" Content="Close" Margin="0,0,8,0" Click="CloseButton_Click" />
      <Button Grid.Column="3" Content="Save" Background="#30343A" Foreground="White" Click="SaveButton_Click" />
    </Grid>
  </Grid>
</Window>