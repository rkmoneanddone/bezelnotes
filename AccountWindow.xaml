<Window x:Class="StickyNotes.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bezel Sticky Notes Account"
        Width="440"
        Height="500"
        MinWidth="440"
        MinHeight="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F7F8FA"
        Foreground="#25282D"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="GoogleButtonStyle"
               TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#202328"/>
            <Setter Property="BorderBrush" Value="#202328"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="12,7"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#343940"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#343940"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#111318"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#111318"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#AAB0B7"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#AAB0B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#25282D"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#AEB4BC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Foreground" Value="#25282D"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#AEB4BC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Foreground" Value="#25282D"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#AEB4BC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Bezel Sticky Notes Account"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#202328"/>

            <TextBlock Margin="0,5,0,0"
                       Text="Sign in to verify your trial or subscription."
                       FontSize="14"
                       Foreground="#484D54"/>

            <TextBlock Margin="0,3,0,0"
                       Text="Your note content stays on this PC."
                       FontSize="12.8"
                       Foreground="#6A7078"/>
        </StackPanel>

        <Button x:Name="GoogleSignInButton"
                Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource GoogleButtonStyle}"
                Content="Continue with Google"
                Click="GoogleSignInButton_Click"/>

        <TextBlock Grid.Row="2"
                   Margin="0,6,0,0"
                   Text="Recommended - opens Google securely in your browser."
                   FontSize="12.5"
                   Foreground="#646A72"
                   TextAlignment="Center"/>

        <Grid Grid.Row="3"
              Margin="0,13,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Height="1"
                    Background="#D6DAE0"
                    VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Margin="10,0"
                       Text="or use email"
                       FontSize="12.8"
                       Foreground="#6A7078"/>

            <Border Grid.Column="2"
                    Height="1"
                    Background="#D6DAE0"
                    VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="4">
            <TextBlock Margin="0,0,0,5"
                       Text="Email address"
                       FontSize="13.5"
                       Foreground="#34383E"/>

            <TextBox x:Name="EmailBox"/>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Margin="0,10,0,0">
            <TextBlock Margin="0,0,0,5"
                       Text="Password"
                       FontSize="13.5"
                       Foreground="#34383E"/>

            <PasswordBox x:Name="PasswordBox"/>
        </StackPanel>

        <Grid Grid.Row="6"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="Sign in"
                    Click="SignInButton_Click"/>

            <Button Grid.Column="2"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="Create account"
                    Click="CreateAccountButton_Click"/>
        </Grid>

        <Border x:Name="StatusBorder"
                Grid.Row="7"
                Margin="0,12,0,0"
                Padding="9"
                Background="#F0F2F4"
                BorderBrush="#D8DCE1"
                BorderThickness="1"
                CornerRadius="6"
                VerticalAlignment="Top">

            <TextBlock x:Name="StatusText"
                       Text="Ready to sign in."
                       FontSize="13.5"
                       Foreground="#34383E"
                       TextWrapping="Wrap"/>
        </Border>

        <TextBlock x:Name="ConfigPathText"
                   Visibility="Collapsed"/>
    </Grid>
</Window>