<Window x:Class="StickyNotes.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bezel Sticky Notes Account"
        Width="440"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7"
        Foreground="#2F3237"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#2F3237"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#2F3237"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#2F3237"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Bezel Sticky Notes Account"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#25282D"/>

        <TextBlock Grid.Row="1"
                   Text="Sign in securely to activate or verify your account."
                   Margin="0,8,0,18"
                   FontSize="14"
                   Foreground="#34373C"
                   TextWrapping="Wrap"/>

        <Button x:Name="GoogleSignInButton"
                Grid.Row="2"
                Height="44"
                HorizontalAlignment="Stretch"
                Content="Continue with Google"
                Click="GoogleSignInButton_Click"/>

        <Grid Grid.Row="3"
              Margin="0,18,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Height="1"
                    Background="#C7CBD1"
                    VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="or"
                       Margin="12,0"
                       Foreground="#4A4E54"
                       FontSize="14"/>

            <Border Grid.Column="2"
                    Height="1"
                    Background="#C7CBD1"
                    VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Email"
                       FontSize="14"
                       Foreground="#34373C"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="EmailBox"/>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Margin="0,14,0,0">
            <TextBlock Text="Password"
                       FontSize="14"
                       Foreground="#34373C"
                       Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox"/>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    Margin="0,18,0,0">
            <Button Content="Sign in"
                    Width="110"
                    Click="SignInButton_Click"/>
            <Button Content="Create account"
                    Width="140"
                    Margin="10,0,0,0"
                    Click="CreateAccountButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Margin="0,18,0,0">
            <TextBlock x:Name="StatusText"
                       FontSize="14"
                       Foreground="#34373C"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="ConfigPathText"
                       Margin="0,10,0,0"
                       FontSize="13.5"
                       Foreground="#34373C"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>