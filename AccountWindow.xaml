<Window x:Class="StickyNotes.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bezel Sticky Notes Account"
        Width="470"
        Height="610"
        MinWidth="470"
        MinHeight="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        Foreground="#25282D"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#25282D"/>
            <Setter Property="BorderBrush" Value="#25282D"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#25282D"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#B8BDC5"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#25282D"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#AEB4BD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="44"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#25282D"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#AEB4BD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="44"/>
        </Style>

    </Window.Resources>

    <Grid Margin="26">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Bezel Sticky Notes Account"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#202328"/>

            <TextBlock Text="Sign in to activate your trial, subscription, and account access."
                       Margin="0,7,0,0"
                       FontSize="14.5"
                       Foreground="#4A4E55"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="12"
                Background="#EEF3F8"
                BorderBrush="#D5DEE7"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>
                <TextBlock Text="Secure account sign-in"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           Foreground="#27313A"/>

                <TextBlock Margin="0,4,0,0"
                           FontSize="13.5"
                           Foreground="#46515C"
                           TextWrapping="Wrap"
                           Text="Your notes stay on this PC. Firebase is used only for account, trial, and entitlement verification."/>
            </StackPanel>
        </Border>

        <Button x:Name="GoogleSignInButton"
                Grid.Row="2"
                Margin="0,18,0,0"
                Style="{StaticResource PrimaryButtonStyle}"
                Content="Continue with Google"
                Click="GoogleSignInButton_Click"/>

        <TextBlock Grid.Row="3"
                   Margin="0,7,0,0"
                   FontSize="12.8"
                   Foreground="#5A5F66"
                   TextAlignment="Center"
                   Text="Recommended - opens Google securely in your browser."/>

        <Grid Grid.Row="4"
              Margin="0,18,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Height="1"
                    Background="#D1D5DB"
                    VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="or use email"
                       Margin="12,0"
                       FontSize="13"
                       Foreground="#6A7078"/>

            <Border Grid.Column="2"
                    Height="1"
                    Background="#D1D5DB"
                    VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="5">
            <TextBlock Text="Email address"
                       FontSize="14"
                       Foreground="#31353B"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="EmailBox"/>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Margin="0,14,0,0">
            <TextBlock Text="Password"
                       FontSize="14"
                       Foreground="#31353B"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="PasswordBox"/>
        </StackPanel>

        <Grid Grid.Row="7"
              Margin="0,16,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="Sign in"
                    Click="SignInButton_Click"/>

            <Button Grid.Column="2"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="Create account"
                    Click="CreateAccountButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="8"
                    Margin="0,18,0,0">

            <Border x:Name="StatusBorder"
                    Padding="11"
                    Background="#F0F1F3"
                    BorderBrush="#D4D7DC"
                    BorderThickness="1"
                    CornerRadius="7">

                <StackPanel>
                    <TextBlock Text="Status"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#3B4047"/>

                    <TextBlock x:Name="StatusText"
                               Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="#30343A"
                               TextWrapping="Wrap"
                               Text="Ready to sign in."/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ConfigPathText"
                       Margin="0,10,0,0"
                       FontSize="12.8"
                       Foreground="#61666D"
                       TextWrapping="Wrap"/>
        </StackPanel>

    </Grid>
</Window>