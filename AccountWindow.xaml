<Window x:Class="StickyNotes.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bezel Sticky Notes Account"
        Width="360"
        Height="405"
        MinWidth="360"
        MinHeight="405"
        MaxWidth="360"
        MaxHeight="405"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA"
        Foreground="#25282D"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="GoogleButtonStyle"
               TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#202328"/>
            <Setter Property="BorderBrush" Value="#202328"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#343940"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#111318"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButtonStyle"
               TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#25282D"/>
            <Setter Property="BorderBrush" Value="#AEB4BC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="#25282D"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#AEB4BC"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="#25282D"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#AEB4BC"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Account"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="#202328"/>

            <TextBlock Margin="0,3,0,0"
                       Text="Sign in to verify your trial or subscription."
                       FontSize="13"
                       Foreground="#555B63"/>
        </StackPanel>

        <Button x:Name="GoogleSignInButton"
                Grid.Row="1"
                Margin="0,13,0,0"
                Style="{StaticResource GoogleButtonStyle}"
                Content="Continue with Google"
                Click="GoogleSignInButton_Click"/>

        <Grid Grid.Row="2"
              Margin="0,11,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Height="1"
                    Background="#D6DAE0"
                    VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Margin="8,0"
                       Text="or email"
                       FontSize="12.5"
                       Foreground="#70757C"/>

            <Border Grid.Column="2"
                    Height="1"
                    Background="#D6DAE0"
                    VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="3">
            <TextBlock Margin="0,0,0,4"
                       Text="Email"
                       FontSize="13"/>

            <TextBox x:Name="EmailBox"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Margin="0,8,0,0">
            <TextBlock Margin="0,0,0,4"
                       Text="Password"
                       FontSize="13"/>

            <PasswordBox x:Name="PasswordBox"/>
        </StackPanel>

        <Grid Grid.Row="5"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource SmallButtonStyle}"
                    Content="Sign in"
                    Click="SignInButton_Click"/>

            <Button Grid.Column="2"
                    Style="{StaticResource SmallButtonStyle}"
                    Content="Create account"
                    Click="CreateAccountButton_Click"/>
        </Grid>

        <TextBlock Grid.Row="6"
                   Margin="0,9,0,0"
                   Text="Your note content stays on this PC."
                   FontSize="12"
                   Foreground="#6A7078"
                   TextAlignment="Center"/>

        <Border x:Name="StatusBorder"
                Grid.Row="7"
                Margin="0,9,0,0"
                Padding="8"
                Background="#F0F2F4"
                BorderBrush="#D8DCE1"
                BorderThickness="1"
                CornerRadius="6"
                VerticalAlignment="Top">

            <TextBlock x:Name="StatusText"
                       Text="Ready to sign in."
                       FontSize="12.8"
                       Foreground="#34383E"
                       TextWrapping="Wrap"/>
        </Border>

        <TextBlock x:Name="ConfigPathText"
                   Visibility="Collapsed"/>
    </Grid>
</Window>