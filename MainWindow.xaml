<Window x:Class="StickyNotes.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:StickyNotes.Services" Title="StickyNotes" Width="14" Height="510" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" AllowsTransparency="True" Background="Transparent" Loaded="Window_Loaded" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" KeyDown="Window_KeyDown">
  <Window.Resources>
    <services:NoteColorConverter x:Key="NoteColorConverter" />
    <services:NoteForegroundConverter x:Key="NoteForegroundConverter" />
    <Style x:Key="RoundButton" TargetType="Button">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#EEF0F3" />
      <Setter Property="Foreground" Value="#565A60" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </Window.Resources>
  <Grid x:Name="RootGrid">
    <!-- REST -->
    <Border x:Name="RestPill" Width="12" ClipToBounds="True" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#5F6675" CornerRadius="6,0,0,6" Padding="2,6" Opacity="0.96" MaxHeight="166">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Exit StickyNotes" Click="ExitMenuItem_Click" />
        </ContextMenu>
      </Border.ContextMenu>
      <ItemsControl x:Name="RestDashList" HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="7" Height="18" Margin="0,2" CornerRadius="3.5" Background="{Binding Color, Converter={StaticResource NoteColorConverter}}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <!-- FAN -->
    <Grid x:Name="FanDeck" MouseEnter="FanDeck_MouseEnter" MouseLeave="FanDeck_MouseLeave" HorizontalAlignment="Right" VerticalAlignment="Center" Width="46" Visibility="Collapsed" Opacity="0">
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
        <ScrollViewer x:Name="FanNotesScrollViewer" Height="410" Width="46" HorizontalAlignment="Right" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" Focusable="False" PreviewMouseWheel="FanNotesScrollViewer_PreviewMouseWheel">
          <ItemsControl x:Name="FanNotesList" HorizontalAlignment="Right" Width="46">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="46" Height="116" Margin="0,-12,0,0" CornerRadius="15,0,0,15" Background="{Binding Color, Converter={StaticResource NoteColorConverter}}" BorderBrush="#22000000" BorderThickness="1" Cursor="Hand" MouseEnter="FanNote_MouseEnter" MouseLeave="FanNote_MouseLeave">
                  <Grid>
                    <Border Width="1" Height="88" Margin="0,0,6,0" HorizontalAlignment="Right" Background="#24000000" />
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="DemiBold" Foreground="{Binding Color, Converter={StaticResource NoteForegroundConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Width="86" MaxWidth="86">
                      <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90" />
                      </TextBlock.LayoutTransform>
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button x:Name="AddButton" Content="+" Width="34" Height="34" Margin="0,12,8,0" HorizontalAlignment="Right" FontSize="21" Style="{StaticResource RoundButton}" Click="AddButton_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" CornerRadius="17">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Button.Template>
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Header="Settings" Cursor="Hand" Click="SettingsMenuItem_Click" />
              <MenuItem Header="Exit StickyNotes" Click="ExitMenuItem_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>
    <!-- FULL OPEN -->
    <Grid x:Name="OpenState" Visibility="Collapsed" Opacity="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="94" />
      </Grid.ColumnDefinitions>
      <Border x:Name="OpenNoteCard" Grid.Column="0" Width="308" Height="430" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="16" BorderBrush="#26000000" BorderThickness="1" Padding="14" Background="{Binding Color, Converter={StaticResource NoteColorConverter}}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.24" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TitleBox" FontSize="18" Foreground="{Binding Color, Converter={StaticResource NoteForegroundConverter}}" FontWeight="DemiBold" Background="Transparent" BorderThickness="0" Padding="0" TextChanged="Editor_TextChanged" />
            <Button Grid.Column="1" Content="-" Width="28" Height="28" FontSize="17" Style="{StaticResource RoundButton}" ToolTip="Minimize note" Click="CloseNoteButton_Click" Cursor="Hand">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}" CornerRadius="14">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
          <Rectangle Grid.Row="1" Height="1" Margin="0,5,0,5" VerticalAlignment="Center" Stroke="#45000000" StrokeThickness="1" StrokeDashArray="1,3" />
          <TextBox x:Name="ContentBox" Grid.Row="2" Margin="0,10,0,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" FontSize="15" Foreground="{Binding Color, Converter={StaticResource NoteForegroundConverter}}" TextChanged="Editor_TextChanged" />
          <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.Row="3" Margin="-14,2,-14,-14" Padding="8,9,8,11" Background="#FFFFFFFF" BorderBrush="#44000000" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="20" Height="20" Margin="0,0,6,0" Background="#FFDD69" BorderThickness="0" Tag="Yellow" Cursor="Hand" Click="ColorButton_Click" />
                <Button Width="20" Height="20" Margin="0,0,6,0" Background="#AEE5D1" BorderThickness="0" Tag="Mint" Cursor="Hand" Click="ColorButton_Click" />
                <Button Width="20" Height="20" Margin="0,0,6,0" Background="#B7DCF4" BorderThickness="0" Tag="Blue" Cursor="Hand" Click="ColorButton_Click" />
                <Button xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="20" Height="20" Margin="0,0,6,0" Background="#FFD3A1" BorderThickness="0" Tag="Orange" Cursor="Hand" Click="ColorButton_Click" />
                <Button Width="20" Height="20" Margin="0,0,6,0" Background="#586174" BorderThickness="0" Tag="Slate" Cursor="Hand" Click="ColorButton_Click" />
                <Button Width="20" Height="20" Background="#466B57" BorderThickness="0" Tag="Forest" Cursor="Hand" Click="ColorButton_Click" />
              </StackPanel>
              <TextBlock x:Name="SaveStatusText" Grid.Column="1" Margin="12,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13.5" Foreground="#666666" />
              <Button Grid.Column="2" Content="Delete" Padding="10,4" BorderThickness="0" Background="#FFF3F3F3" Foreground="#5E2F2F" Cursor="Hand" Click="DeleteButton_Click" FontSize="14.5" FontWeight="SemiBold" />
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="1" Width="92" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" x:Name="OpenDeckRail">
        <ListBox x:Name="OpenDeckList" Width="92" MaxHeight="410" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden" SelectionChanged="OpenDeckList_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Right" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="86" Height="60" Margin="0,-5,0,0" CornerRadius="13,0,0,13" Background="{Binding Color, Converter={StaticResource NoteColorConverter}}" BorderBrush="#22000000" BorderThickness="1" Padding="8,6" Cursor="Hand">
                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="DemiBold" Foreground="{Binding Color, Converter={StaticResource NoteForegroundConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" />
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>
    <Popup x:Name="DeleteConfirmPopup" Placement="Center" PlacementTarget="{Binding ElementName=OpenNoteCard}" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
      <Border Width="250" Padding="18" CornerRadius="14" Background="#F7F7F8" BorderBrush="#33000000" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" />
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="Delete this note?" FontSize="16" FontWeight="SemiBold" Foreground="#333333" />
          <TextBlock Text="This note contains content. This cannot be undone." Margin="0,8,0,16" FontSize="13.5" TextWrapping="Wrap" Foreground="#666666" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="76" Height="32" Margin="0,0,8,0" Cursor="Hand" Style="{StaticResource RoundButton}" Click="DeleteConfirmCancel_Click" />
            <Button Content="Delete" Width="76" Height="32" Cursor="Hand" Background="#F5DADB" Foreground="#8A4040" Style="{StaticResource RoundButton}" Click="DeleteConfirmYes_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
    <!-- POINT 3: read-only hover preview attached to the hovered fan tab -->
    <Popup x:Name="PreviewPopup" Placement="Custom" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" HorizontalOffset="0" MouseEnter="PreviewPopup_MouseEnter" MouseLeave="PreviewPopup_MouseLeave">
      <Grid>
        <Border x:Name="PreviewCard" Width="235" Cursor="Hand" MouseLeftButtonUp="PreviewCard_MouseLeftButtonUp" MinHeight="150" MaxHeight="235" Padding="0,15,18,17" CornerRadius="18,0,0,18" Background="{Binding Color, Converter={StaticResource NoteColorConverter}}" BorderBrush="#22000000" BorderThickness="1" Opacity="0" RenderTransformOrigin="1,0.5">
          <Border.RenderTransform>
            <TranslateTransform X="14" />
          </Border.RenderTransform>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="26" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="26" BorderBrush="#22000000" BorderThickness="0,0,1,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <TextBlock Text="{Binding Title}" Width="132" FontSize="17" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{Binding Color, Converter={StaticResource NoteForegroundConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0">
                <TextBlock.LayoutTransform>
                  <RotateTransform Angle="-90" />
                </TextBlock.LayoutTransform>
              </TextBlock>
            </Border>
            <Grid Grid.Column="1" Margin="10,0,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding Color, Converter={StaticResource NoteForegroundConverter}}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="2" Text="{Binding Content}" FontSize="14" FontWeight="Normal" Foreground="{Binding Color, Converter={StaticResource NoteForegroundConverter}}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="21" MaxHeight="165" />
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Popup>
  </Grid>
</Window>